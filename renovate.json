{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "pinDigests": true,
  "packageRules": [
    { "matchUpdateTypes": ["major"], "dependencyDashboardApproval": false },
    {
      "description": "Own images: plain tags, so the UGOS Docker app shows them",
      "matchPackageNames": [
        "ghcr.io/grigoriev/sb-ctrl",
        "ghcr.io/grigoriev/sb-ctrl-ui"
      ],
      "pinDigests": false
    }
  ]
}
