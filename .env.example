# Copy to .env and fill in. .env is git-ignored.

# Public hostname the UI and API are served on. Its DNS zone must be at IONOS.
DOMAIN=sb.example.com

# Email for the Let's Encrypt account.
ACME_EMAIL=you@example.com

# IONOS DNS API key for the DNS-01 challenge, in the form "prefix.secret".
# Create it at https://developer.hosting.ionos.de/keys
IONOS_API_KEY=prefix.secret

# Host path holding the .staging dir and the Plex library roots (one filesystem).
# Mounted into sb-ctrl at /data.
MEDIA_ROOT=/data
